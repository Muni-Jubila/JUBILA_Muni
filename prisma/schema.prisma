generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model ARCHIVO_JUBILACION {
  ID_ARCHIVO          Int       @id(map: "PK__ARCHIVO___E2F250292B898A87") @default(autoincrement())
  ID_JUBILA           Int
  NOMBRE_ARCHIVO      String    @db.NVarChar(255)
  TIPO_ARCHIVO        String?   @db.NVarChar(100)
  DATOS_ARCHIVO       Bytes @db.VarBinary(Max)
  FECHA_SUBIDA        DateTime
  USUARIO_SUBIDA      Int       @default(1)
  FECHA_ELIMINACION   DateTime?
  USUARIO_ELIMINACION Int?
  BIT_BORRADO         Boolean   @default(false)
  JUBILA              JUBILA    @relation(fields: [ID_JUBILA], references: [ID_JUBILA], onDelete: Cascade, onUpdate: NoAction, map: "fk_ARCHIVO_JUBILA")
  USUARIO             USUARIO   @relation("ARCHIVO_JUBILACION_USUARIO_SUBIDA", fields: [USUARIO_SUBIDA], references: [ID_USUARIO], onUpdate: NoAction, map: "fk_ARCHIVO_USUARIO")
  USUARIO_ELIMINA     USUARIO?  @relation("ARCHIVO_JUBILACION_USUARIO_ELIMINACION", fields: [USUARIO_ELIMINACION], references: [ID_USUARIO], onUpdate: NoAction)

  @@index([ID_JUBILA], map: "idx_archivo_id_jubila")
  @@index([USUARIO_SUBIDA], map: "idx_archivo_usuario_subida")
  @@map("JUBILA_ARCHIVO_JUBILACION")
}

model CAUSA_BAJA {
  ID_CAUSA_BAJA        Int                    @id(map: "PK__BENEFICI__359D6A0B0E5AB44B") @default(autoincrement())
  NOMBRE_CAUSA_BAJA    String                 @db.NVarChar(255)
  DESCRIPCION          String?                @db.NVarChar(500)
  HISTORIAL_CAUSA_BAJA HISTORIAL_CAUSA_BAJA[]

  @@map("JUBILA_CAUSA_BAJA")
}

model DATOS_PERSONALES_AGENTE_JUBILA {
  ID_DATOS_PERSONALES_AGENTE_JUBILA      Int                      @id(map: "PK__DATOS_PE__57B79B1EFC671D62") @default(autoincrement())
  ID_REGIMEN_JUBILATORIO                 Int?
  DNI_AGENTE                             String?                  @unique(map: "UQ__DATOS_PE__0CB30166200518FE") @db.NVarChar(50)
  NOMBRE_AGENTE                          String                   @db.NVarChar(255)
  APELLIDO_AGENTE                        String                   @db.NVarChar(255)
  SEGUNDO_NOMBRE_AGENTE                  String?                  @db.NVarChar(255)
  SEGUNDO_APELLIDO_AGENTE                String?                  @db.NVarChar(255)
  FECHA_NACIMIENTO                       DateTime                 @db.Date
  SECRETARIA                             String?                  @db.NVarChar(255)
  PROGRAMA                               String?                  @db.NVarChar(255)
  CARGO                                  String?                  @db.NVarChar(255)
  SEXO                                   String?                  @db.NVarChar(50)
  ANTIGUEDAD_RECIBO                      DateTime?                @db.Date
  ANTIGUEDAD_LICENCIAS                   DateTime?                @db.Date
  FECHA_ESTIMADA_JUBILACI_N_ORDINARIA    DateTime?                @map("FECHA_ESTIMADA_JUBILACIÓN_ORDINARIA") @db.Date
  EDAD_ESTIMACION_JUBILACION             Int?
  ESTADO_ACTIVO                          Boolean                  @default(true)
  CUIL                                   String?                  @db.NVarChar(20)
  NUMERO_TELEFONO                        String?                  @db.NVarChar(50)
  CORREO_ELECTRONICO                     String?                  @db.NVarChar(255)
  ANTIGUEDAD_LICENCIAS_CALC              String?                  @db.NVarChar(200)
  ANTIGUEDAD_RECIBO_CALC                 String?                  @db.NVarChar(200)
  FECHA_INICIO_CREACION_DATOS_PERSONALES DateTime                 @default(now())
  USUARIO_CREACION                       Int?
  FECHA_ULTIMA_MODIFICACION              DateTime?
  USUARIO_ULTIMA_MODIFICACION            Int?
  BIT_BORRADO                            Boolean                  @default(false)
  ORIGEN                                 String                   @default("JUBILA") @db.NVarChar(20)
  REGIMEN_JUBILATORIO                    REGIMEN_JUBILATORIO?     @relation(fields: [ID_REGIMEN_JUBILATORIO], references: [ID_REGIMEN_JUBILATORIO], onDelete: NoAction, onUpdate: NoAction, map: "fk_AGENTE_REGIMEN")
  USUARIO                                USUARIO?                 @relation(fields: [USUARIO_CREACION], references: [ID_USUARIO], onDelete: NoAction, onUpdate: NoAction, map: "FK_DATOS_PERSONALES_USUARIO_CREACION")
  JUBILA                                 JUBILA[]
  CARRERA_ADMINISTRATIVA                 CARRERA_ADMINISTRATIVA[]

  @@index([APELLIDO_AGENTE, NOMBRE_AGENTE], map: "idx_dp_apellido_nombre")
  @@index([FECHA_ESTIMADA_JUBILACI_N_ORDINARIA], map: "idx_dp_fecha_estimada")
  @@index([ID_REGIMEN_JUBILATORIO], map: "idx_dp_id_regimen")
  @@map("COMUN_DATOS_PERSONALES_AGENTE_JUBILA")
}

model HISTORIAL_CAUSA_BAJA {
  ID_HISTORIAL_CAUSA_BAJA     Int        @id(map: "PK__HISTORIA__17D1D2A87070E491") @default(autoincrement())
  ID_JUBILA                   Int
  ID_CAUSA_BAJA               Int
  FECHA_DESDE_CAUSA_BAJA      DateTime   @db.Date
  FECHA_FIN_CAUSA_BAJA        DateTime?  @db.Date
  USUARIO_ULTIMA_MODIFICACION Int        @default(1)
  CAUSA_BAJA                  CAUSA_BAJA @relation(fields: [ID_CAUSA_BAJA], references: [ID_CAUSA_BAJA], onUpdate: NoAction, map: "fk_HISTORIAL_CAUSA_BAJA_CAUSA")
  JUBILA                      JUBILA     @relation(fields: [ID_JUBILA], references: [ID_JUBILA], onDelete: Cascade, onUpdate: NoAction, map: "fk_HISTORIAL_JUBILA")
  USUARIO                     USUARIO    @relation(fields: [USUARIO_ULTIMA_MODIFICACION], references: [ID_USUARIO], onUpdate: NoAction, map: "fk_HISTORIAL_USUARIO")

  @@index([ID_JUBILA], map: "idx_historial_id_jubila")
  @@index([ID_CAUSA_BAJA], map: "idx_historial_id_causa")
  @@map("JUBILA_HISTORIAL_CAUSA_BAJA")
}

model JUBILA {
  ID_JUBILA                                                Int                                   @id(map: "PK__JUBILA__D2716A6E1CA75C1F") @default(autoincrement())
  ID_AGENTE                                                Int
  INFORMACION_LABORAL_NUMERO_TRAMITE                       String?                               @db.NVarChar(255)
  INFORMACION_LABORAL_FECHA_BAJA                           DateTime?                             @db.Date
  INFORMACION_LABORAL_NUMERO_EXPEDIENTE_MUNICIPAL_RENUNCIA String?                               @db.NVarChar(255)
  INFORMACION_LABORAL_JUBILACION_NUMERO_EXPEDIENTE_CAJA    String?                               @db.NVarChar(255)
  INFORMACION_LABORAL_NUMERO_RESOLUCION_CAJA               String?                               @db.NVarChar(255)
  INFORMACION_LABORAL_NUMERO_EXPEDIENTE_CAJA_DENEGADA      String?                               @db.NVarChar(255)
  PASIVIDAD_FECHA_SOLICITUD                                DateTime?                             @db.Date
  PASIVIDAD_FECHA_ESTIMADA_JUBILACION_ORDINARIA            DateTime?                             @db.Date
  PASIVIDAD_NUMERO_EXPEDIENTE_PASIVIDAD                    String?                               @db.NVarChar(255)
  PASIVIDAD_FECHA_FIRMA_CONVENIO                           DateTime?                             @db.Date
  PASIVIDAD_FECHA_INICIO_PASIVIDAD                         DateTime?                             @db.Date
  PASIVIDAD_OBSERVACIONES_PASIVIDAD                        String?                               @db.NVarChar(500)
  NOTIFICACION_ARTICULO_CUARENTAYTRES                      DateTime?                             @db.Date
  NOTIFICACION_NUMERO_EXPEDIENTE_SUSPENCION_PAGO           String?                               @db.NVarChar(255)
  OBSERVACIONES                                            String?                               @db.NVarChar(500)
  FECHA_INICIO_CREACION_JUBILA                             DateTime
  USUARIO_CREACION                                         Int                                   @default(1)
  FECHA_ULTIMA_MODIFICACION                                DateTime?
  USUARIO_MODIFICACION                                     Int?
  BIT_BORRADO                                              Boolean                               @default(false)
  ARCHIVO_JUBILACION                                       ARCHIVO_JUBILACION[]
  DATOS_PERSONALES_AGENTE_JUBILA                           DATOS_PERSONALES_AGENTE_JUBILA        @relation(fields: [ID_AGENTE], references: [ID_DATOS_PERSONALES_AGENTE_JUBILA], onUpdate: NoAction, map: "fk_JUBILA_AGENTE")
  USUARIO_JUBILA_USUARIO_CREACIONToUSUARIO                 USUARIO                               @relation("JUBILA_USUARIO_CREACIONToUSUARIO", fields: [USUARIO_CREACION], references: [ID_USUARIO], onUpdate: NoAction, map: "fk_JUBILA_USUARIO_CREACION")
  USUARIO_JUBILA_USUARIO_MODIFICACIONToUSUARIO             USUARIO?                              @relation("JUBILA_USUARIO_MODIFICACIONToUSUARIO", fields: [USUARIO_MODIFICACION], references: [ID_USUARIO], onDelete: NoAction, onUpdate: NoAction, map: "fk_JUBILA_USUARIO_MODIFICACION")
  OTORGAMIENTO_RENOVACION_PROVISORIAS                      OTORGAMIENTO_RENOVACION_PROVISORIAS[]
  HISTORIAL_CAUSA_BAJA                                     HISTORIAL_CAUSA_BAJA[]

  @@index([ID_AGENTE], map: "idx_jubila_id_agente")
  @@index([BIT_BORRADO, FECHA_ULTIMA_MODIFICACION(sort: Desc)], map: "idx_jubila_borrado_ultima_mod")
  @@map("JUBILA_DATOS")
}

model OTORGAMIENTO_RENOVACION_PROVISORIAS {
  ID_OTORGAMIENTO_RENOVACION_PROVISORIAS Int       @id(map: "PK__OTORGAMI__89CCD18557FBBBA7") @default(autoincrement())
  ID_JUBILA                              Int
  NUMERO_RESOLUCION_RENOVACION           String?   @db.NVarChar(255)
  NUMERO_EXPEDIENTE_MUNICIPAL            String?   @db.NVarChar(255)
  FECHA_DESDE_PROVISORIA                 DateTime?
  FECHA_HASTA_PROVISORIA                 DateTime?
  NUMERO_DECRETO_RESOLUCION_MUNICIPAL    String?   @db.NVarChar(255)
  JUBILA                                 JUBILA    @relation(fields: [ID_JUBILA], references: [ID_JUBILA], onDelete: Cascade, onUpdate: NoAction, map: "fk_OTORGAMIENTO_JUBILA")

  @@index([ID_JUBILA, FECHA_HASTA_PROVISORIA], map: "idx_otorg_jubila_fecha_hasta")
  @@map("JUBILA_OTORGAMIENTO_RENOVACION_PROVISORIAS")
}

model REGIMEN_JUBILATORIO {
  ID_REGIMEN_JUBILATORIO         Int                              @id(map: "PK__REGIMEN___ACF78BB46A8B8962") @default(autoincrement())
  NOMBRE_REGIMEN                 String                           @db.NVarChar(255)
  SEXO                           String?                          @db.NVarChar(50)
  EDAD_REQUERIDA                 Int
  ANOS_APORTES_REQUERIDOS        Int
  DESCRIPCION                    String?                          @db.NVarChar(500)
  DATOS_PERSONALES_AGENTE_JUBILA DATOS_PERSONALES_AGENTE_JUBILA[]

  @@map("JUBILA_REGIMEN_JUBILATORIO")
}

model SESION {
  ID_SESION         Int       @id(map: "PK__SESION__4D1F3E2A632B6A2A") @default(autoincrement())
  ID_USUARIO        Int
  FECHA_HORA_INICIO DateTime
  FECHA_HORA_FIN    DateTime?
  ID_DISPOSITIVO    Int?
  IP                String?   @db.NVarChar(45)
  USER_AGENT        String?
  USUARIO           USUARIO   @relation(fields: [ID_USUARIO], references: [ID_USUARIO], onUpdate: NoAction, map: "fk_SESION_USUARIO")

  @@index([ID_USUARIO], map: "idx_sesion_id_usuario")
  @@map("JUBILA_SESION")
}

model USUARIO {
  ID_USUARIO                                  Int                              @id(map: "JUBILA_USUARIO_pkey") @default(autoincrement())
  NOMBRE_USUARIO                              String                           @unique(map: "JUBILA_USUARIO_NOMBRE_USUARIO_key") @db.NVarChar(255)
  CONTRASENA_USUARIO                          String                           @db.NVarChar(255)
  DEBE_CAMBIAR_CONTRASENA                     Boolean                          @default(true)
  ID_ROL_JUBILA                               Int                              @map("ID_ROL")
  ARCHIVO_JUBILACION                          ARCHIVO_JUBILACION[]             @relation("ARCHIVO_JUBILACION_USUARIO_SUBIDA")
  ARCHIVO_JUBILACION_USUARIO_ELIMINACION      ARCHIVO_JUBILACION[]             @relation("ARCHIVO_JUBILACION_USUARIO_ELIMINACION")
  DATOS_PERSONALES_AGENTE_JUBILA              DATOS_PERSONALES_AGENTE_JUBILA[]
  HISTORIAL_CAUSA_BAJA                        HISTORIAL_CAUSA_BAJA[]
  JUBILA_JUBILA_USUARIO_CREACIONToUSUARIO     JUBILA[]                         @relation("JUBILA_USUARIO_CREACIONToUSUARIO")
  JUBILA_JUBILA_USUARIO_MODIFICACIONToUSUARIO JUBILA[]                         @relation("JUBILA_USUARIO_MODIFICACIONToUSUARIO")
  ROL_JUBILA                                  ROL_JUBILA?                      @relation(fields: [ID_ROL_JUBILA], references: [ID_ROL_JUBILA], onDelete: NoAction, onUpdate: NoAction, map: "FK_JUBILA_USUARIO_ROL")
  SESION                                      SESION[]

  @@index([ID_ROL_JUBILA], map: "IX_USUARIO_ID_ROL_JUBILA")
  @@map("JUBILA_USUARIO")
}

model ROL_JUBILA {
  ID_ROL_JUBILA Int       @id(map: "PK_Rol_Jubila") @default(autoincrement())
  NOMBRE_ROL    String    @unique(map: "UQ_Rol_Jubila_NOMBRE_ROL") @db.NVarChar(32)
  USUARIO       USUARIO[]

  @@map("JUBILA_ROL")
}

model CARRERA_ADMINISTRATIVA {
  ID_CARRERA                     Int                             @id(map: "PK__CARRERA___FAB78CADC0AC7DEA") @default(autoincrement())
  DOCUMENTO_EMPLEADO             String                          @db.NVarChar(20)
  FECHA_ALTA                     DateTime?                       @db.DateTime2
  FECHA_BAJA                     DateTime?                       @db.DateTime2
  CAUSA_BAJA                     String?                         @db.NVarChar(255)
  FECHA_CREACION                 DateTime?                       @default(now())
  DATOS_PERSONALES_AGENTE_JUBILA DATOS_PERSONALES_AGENTE_JUBILA? @relation(fields: [DOCUMENTO_EMPLEADO], references: [DNI_AGENTE], onDelete: NoAction, onUpdate: NoAction)

  @@unique([DOCUMENTO_EMPLEADO, FECHA_ALTA], map: "UQ_CARRERA_ADMINISTRATIVA_DOCUMENTO_FECHA_ALTA")
  @@index([DOCUMENTO_EMPLEADO], map: "IX_CARRERA_ADMINISTRATIVA_DOCUMENTO")
  @@map("COMUN_CARRERA_ADMINISTRATIVA")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría y trazabilidad (26/11/2026)
// ─────────────────────────────────────────────────────────────────────────────
model JUBILA_AUDITORIA {
  ID_AUDITORIA   BigInt   @id @default(autoincrement())
  TABLA          String   @db.NVarChar(100)
  REGISTRO_ID    String   @db.NVarChar(50)
  OPERACION      String   @db.Char(1)
  ID_USUARIO     Int?
  USUARIO        String?  @db.NVarChar(100)
  FECHA          DateTime @default(now()) @db.DateTime2
  ID_DISPOSITIVO Int?
  IP             String?  @db.NVarChar(45)
  DATOS_ANTES    String? @db.NVarChar(Max)
  DATOS_DESPUES  String? @db.NVarChar(Max)

  @@index([TABLA, REGISTRO_ID, FECHA(sort: Desc)])
  @@index([FECHA(sort: Desc)])
}

model COMUN_UBICACION {
  ID_UBICACION Int     @id @default(autoincrement())
  NOMBRE       String  @db.NVarChar(150)
  SEDE         String? @db.NVarChar(100)
  PISO         String? @db.NVarChar(20)
  OFICINA      String? @db.NVarChar(100)
  CIDR         String? @db.NVarChar(18)
  ACTIVO       Boolean @default(true)
  NOTAS        String?
}

model COMUN_EQUIPO {
  ID_EQUIPO      Int     @id @default(autoincrement())
  HOSTNAME       String? @db.NVarChar(100)
  IP_ASIGNADA    String? @db.NVarChar(45)
  ID_UBICACION   Int?
  RESPONSABLE    String? @db.NVarChar(255)
  NRO_INVENTARIO String? @db.NVarChar(100)
  ACTIVO         Boolean @default(true)
  NOTAS          String?

  @@index([IP_ASIGNADA])
}

model COMUN_DISPOSITIVO {
  ID_DISPOSITIVO Int       @id @default(autoincrement())
  IDENTIFICADOR  String    @unique @default(dbgenerated("newid()")) @db.UniqueIdentifier
  NOMBRE         String?   @db.NVarChar(100)
  ID_EQUIPO      Int?
  PLATAFORMA     String?   @db.NVarChar(50)
  NAVEGADOR      String?   @db.NVarChar(50)
  USER_AGENT     String?
  PRIMER_USO     DateTime  @default(now()) @db.DateTime2
  ULTIMO_USO     DateTime? @db.DateTime2
  ULTIMA_IP      String?   @db.NVarChar(45)
  CONFIABLE      Boolean   @default(false)
  NOTAS          String?
}
